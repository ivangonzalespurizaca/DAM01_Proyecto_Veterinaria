<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/ivDetalleFotoMascota"
                android:layout_width="70dp"
                android:layout_height="70dp"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_pet"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full"
                app:strokeColor="@color/brand_blue"
                app:strokeWidth="2dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="16dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvDetalleMascota"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/montserrat_bold"
                    android:text="Nombre"
                    android:textColor="@color/brand_blue"
                    android:textSize="18sp" />

                <TextView
                    android:id="@+id/tvDetalleFecha"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Fecha"
                    android:textColor="@color/text_muted"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>

        <com.google.android.material.divider.MaterialDivider
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginVertical="16dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="2">

            <TextView
                android:id="@+id/tvDetallePeso"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/montserrat_medium"
                android:text="Peso: --"
                android:drawableStart="@drawable/ic_pet"
                android:drawablePadding="8dp" />

            <TextView
                android:id="@+id/tvDetalleTemp"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/montserrat_medium"
                android:text="Temp: --"
                android:drawableStart="@drawable/ic_clock"
                android:drawablePadding="8dp" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="MOTIVO"
            android:fontFamily="@font/montserrat_bold"
            android:textSize="11sp"
            android:textColor="@color/text_muted" />
        <TextView
            android:id="@+id/tvDetalleMotivo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="..." />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="DIAGNÓSTICO"
            android:fontFamily="@font/montserrat_bold"
            android:textSize="11sp"
            android:textColor="@color/text_muted" />
        <TextView
            android:id="@+id/tvDetalleDiagnostico"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="..." />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/layoutDetalleTratamiento"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            app:cardBackgroundColor="@color/brand_background"
            app:cardCornerRadius="12dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">
                <TextView
                    android:id="@+id/tvDetalleMedicamento"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/montserrat_bold"
                    android:text="Medicamento" />
                <TextView
                    android:id="@+id/tvDetalleDosisFrecuencia"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Dosis" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="RECOMENDACIONES"
            android:fontFamily="@font/montserrat_bold"
            android:textSize="11sp"
            android:textColor="@color/text_muted" />
        <TextView
            android:id="@+id/tvDetalleRecomendaciones"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="..."
            android:paddingBottom="24dp"/>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>