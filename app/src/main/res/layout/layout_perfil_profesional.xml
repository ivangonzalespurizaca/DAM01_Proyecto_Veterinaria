<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/brand_background"
    android:orientation="vertical"
    android:padding="32dp">

    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center"
        android:layout_marginBottom="24dp"
        android:background="#E5E7EB" />

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/ivFotoPerfilDetalle"
        android:layout_width="90dp"
        android:layout_height="90dp"
        android:layout_gravity="center"
        android:padding="4dp"
        android:scaleType="centerCrop"
        android:src="@drawable/ic_perfil_usuario"
        app:shapeAppearanceOverlay="@style/CircleImage"  app:strokeColor="#023E89"
        app:strokeWidth="1dp" />

    <TextView
        android:id="@+id/tvNombreDetalle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:fontFamily="@font/montserrat_bold"
        android:textAlignment="center"
        android:textColor="@color/text_secondary"
        android:textSize="22sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:fontFamily="@font/montserrat_bold"
        android:text="INFORMACIÓN PERSONAL"
        android:textColor="@color/brand_blue"
        android:textSize="14sp"
        android:letterSpacing="0.05" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="8dp"
        android:background="#E5E7EB" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="DNI / DOCUMENTO"
        android:textColor="@color/text_muted"
        android:textSize="11sp"
        android:fontFamily="@font/montserrat" />
    <TextView
        android:id="@+id/tvDniDetalle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/montserrat_bold"
        android:textColor="@color/text_secondary"
        android:textSize="16sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="NÚMERO DE CELULAR"
        android:textColor="@color/text_muted"
        android:textSize="11sp"
        android:fontFamily="@font/montserrat" />
    <TextView
        android:id="@+id/tvCelularDetalle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/montserrat_bold"
        android:textColor="@color/text_secondary"
        android:textSize="16sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:fontFamily="@font/montserrat_bold"
        android:text="DETALLES PROFESIONALES"
        android:textColor="@color/brand_blue"
        android:textSize="14sp"
        android:letterSpacing="0.05" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="8dp"
        android:background="#E5E7EB" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="COLEGIATURA"
                android:textColor="@color/text_muted"
                android:textSize="11sp"
                android:fontFamily="@font/montserrat"/>
            <TextView
                android:id="@+id/tvCmvpDetalle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/montserrat_bold"
                android:textColor="@color/text_secondary"
                android:textSize="15sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="ESPECIALIDAD"
                android:textColor="@color/text_muted"
                android:textSize="11sp"
                android:fontFamily="@font/montserrat"/>
            <TextView
                android:id="@+id/tvEspecialidadDetalle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/montserrat_bold"
                android:textColor="@color/text_secondary"
                android:textSize="15sp" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="SEDE ASIGNADA"
        android:textColor="@color/text_muted"
        android:textSize="11sp"
        android:fontFamily="@font/montserrat"/>
    <TextView
        android:id="@+id/tvSedeDetalle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:fontFamily="@font/montserrat_bold"
        android:textColor="@color/text_secondary"
        android:textSize="16sp" />

</LinearLayout>