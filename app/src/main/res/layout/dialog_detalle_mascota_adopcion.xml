<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/brand_background"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:fontFamily="@font/montserrat_bold"
            android:text="RESUMEN DE SOLICITUD"
            android:textAlignment="center"
            android:textColor="@color/brand_blue"
            android:textSize="18sp"
            android:letterSpacing="0.05" />

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/ivDetalleFoto"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:layout_gravity="center"
            android:scaleType="centerCrop"
            android:padding="2dp"
            app:shapeAppearanceOverlay="@style/CircleImage"
            app:strokeColor="@color/brand_blue"
            app:strokeWidth="2dp" />

        <TextView
            android:id="@+id/tvDetalleNombre"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:fontFamily="@font/montserrat_bold"
            android:text="Nombre de Mascota"
            android:textAlignment="center"
            android:textColor="@color/brand_blue"
            android:textSize="20sp" />

        <TextView
            android:id="@+id/tvDetalleRazaEspecie"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFamily="@font/montserrat_medium"
            android:text="Raza - Especie"
            android:textAlignment="center"
            android:textColor="@color/text_muted"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tvDetalleStats"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="#F1F5F9"
            android:fontFamily="@font/montserrat_medium"
            android:padding="10dp"
            android:text="Edad: 3 años | Sexo: Macho"
            android:textAlignment="center"
            android:textColor="@color/text_primary"
            android:textSize="14sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="16dp"
            android:background="#E2E8F0" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/montserrat_bold"
            android:text="SU HISTORIA"
            android:textColor="@color/text_muted"
            android:textSize="11sp"
            android:letterSpacing="0.1" />

        <TextView
            android:id="@+id/tvDetalleDescripcion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="@font/montserrat"
            android:text="Descripción detallada de la mascota..."
            android:textColor="@color/text_primary"
            android:textSize="15sp"
            android:lineSpacingExtra="4dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="#E0F2F1"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/montserrat_bold"
                android:text="INFORMACIÓN DE CONTACTO"
                android:textColor="#00695C"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/tvDetalleContacto"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="@font/montserrat_bold"
                android:text="Teléfono: 955163324"
                android:textColor="@color/text_primary" />
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>