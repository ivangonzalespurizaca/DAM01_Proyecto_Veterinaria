<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F9FA">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="32dp"
        android:paddingTop="32dp"
        android:paddingBottom="32dp">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/iconContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toTopOf="parent">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/ivIconoRegistro"
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:padding="20dp"
                android:background="@drawable/bg_icon_rounded_light"
                android:src="@drawable/ic_vaccine"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:shapeAppearanceOverlay="@style/CircleImage"
                app:tint="@color/brand_green" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilSeleccionVacuna"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="36dp"
            android:hint="Seleccionar Vacuna"
            android:textSize="16dp"
            app:layout_constraintTop_toBottomOf="@+id/iconContainer"
            app:startIconDrawable="@drawable/ic_vaccine"
            tools:layout_editor_absoluteX="16dp">

            <AutoCompleteTextView
                android:id="@+id/actvNombreVacuna"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/montserrat"
                android:inputType="none" />
        </com.google.android.material.textfield.TextInputLayout>

        <EditText
            android:id="@+id/etNroDosis"
            android:layout_width="0dp"
            android:layout_height="45dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_input_rounded"
            android:drawableStart="@drawable/ic_add"
            android:drawablePadding="20dp"
            android:drawableTint="#9CA3AF"
            android:fontFamily="@font/montserrat"
            android:hint="Número de dosis (Ej: 1)"
            android:textSize="16dp"
            android:inputType="number"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tilSeleccionVacuna" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/switchEsProgramada"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:fontFamily="@font/montserrat_bold"
            android:text="¿Es una cita programada?"
            android:textColor="@color/brand_blue"
            app:layout_constraintTop_toBottomOf="@id/etNroDosis"
            app:thumbTint="@color/brand_green" />

        <EditText
            android:id="@+id/etFechaProgramada"
            android:layout_width="0dp"
            android:layout_height="45dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_input_rounded"
            android:drawableStart="@drawable/ic_calendar"
            android:drawablePadding="20dp"
            android:drawableTint="#9CA3AF"
            android:textSize="16dp"
            android:visibility="gone"
            android:focusable="false"
            android:clickable="true"
            android:fontFamily="@font/montserrat"
            android:hint="Fecha de la Cita"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/switchEsProgramada" />

        <EditText
            android:id="@+id/etFechaAplicacion"
            android:layout_width="0dp"
            android:layout_height="45dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_input_rounded"
            android:drawableStart="@drawable/ic_calendar"
            android:drawablePadding="20dp"
            android:drawableTint="#9CA3AF"

            android:focusable="false"
            android:textSize="16dp"
            android:clickable="true"
            android:fontFamily="@font/montserrat"
            android:hint="Fecha de Aplicación"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/etFechaProgramada" />

        <EditText
            android:id="@+id/etObservacionesVacuna"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_input_rounded"
            android:fontFamily="@font/montserrat"
            android:gravity="top"
            android:textSize="16dp"
            android:hint="Observaciones médicas..."
            android:inputType="textMultiLine"
            android:minLines="3"
            android:padding="16dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/etFechaAplicacion" />

        <Button
            android:id="@+id/btnGuardarVacuna"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_marginTop="32dp"
            android:background="@drawable/bg_button_rounded"
            android:fontFamily="@font/montserrat_bold"
            android:text="CONFIRMAR REGISTRO"
            android:textColor="@android:color/white"
            app:backgroundTint="@null"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/etObservacionesVacuna" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>