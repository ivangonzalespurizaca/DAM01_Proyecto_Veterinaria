<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F9FA">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="32dp"
        android:paddingTop="32dp"
        android:paddingBottom="32dp">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/iconContainerConsulta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toTopOf="parent">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/ivIconoConsulta"
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:padding="20dp"
                android:background="@drawable/bg_icon_rounded_light"
                android:src="@drawable/ic_medical_services"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:shapeAppearanceOverlay="@style/CircleImage"
                app:tint="@color/brand_green" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <LinearLayout
            android:id="@+id/layoutVitals"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:orientation="horizontal"
            app:layout_constraintTop_toBottomOf="@id/iconContainerConsulta">

            <EditText
                android:id="@+id/etPesoActual"
                android:layout_width="0dp"
                android:layout_height="45dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:background="@drawable/bg_input_rounded"
                android:fontFamily="@font/montserrat"
                android:hint="Peso (kg)"
                android:inputType="numberDecimal"
                android:paddingStart="20dp"
                android:textSize="15sp" />

            <EditText
                android:id="@+id/etTemperatura"
                android:layout_width="0dp"
                android:layout_height="45dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:background="@drawable/bg_input_rounded"
                android:fontFamily="@font/montserrat"
                android:hint="Temp. (°C)"
                android:inputType="numberDecimal"
                android:paddingStart="20dp"
                android:textSize="15sp" />
        </LinearLayout>

        <EditText
            android:id="@+id/etMotivoConsulta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_input_rounded"
            android:fontFamily="@font/montserrat"
            android:hint="Motivo de la consulta..."
            android:inputType="textMultiLine"
            android:minLines="2"
            android:padding="16dp"
            android:textSize="15sp"
            app:layout_constraintTop_toBottomOf="@id/layoutVitals" />

        <EditText
            android:id="@+id/etDiagnostico"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_input_rounded"
            android:fontFamily="@font/montserrat"
            android:hint="Diagnóstico clínico..."
            android:inputType="textMultiLine"
            android:minLines="3"
            android:padding="16dp"
            android:textSize="15sp"
            app:layout_constraintTop_toBottomOf="@id/etMotivoConsulta" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/switchIncluirTratamiento"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:fontFamily="@font/montserrat_bold"
            android:text="¿Requiere tratamiento médico?"
            android:textColor="@color/brand_blue"
            app:layout_constraintTop_toBottomOf="@id/etDiagnostico"
            app:thumbTint="@color/brand_green" />

        <LinearLayout
            android:id="@+id/layoutCamposTratamiento"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            app:layout_constraintTop_toBottomOf="@id/switchIncluirTratamiento">

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilTipoMedicamento"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:hint="Tipo de Medicamento">

                <AutoCompleteTextView
                    android:id="@+id/actvTipoMedicamento"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/montserrat"
                    android:inputType="none" />
            </com.google.android.material.textfield.TextInputLayout>

            <EditText
                android:id="@+id/etNombreMedicamento"
                android:layout_width="match_parent"
                android:layout_height="45dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_input_rounded"
                android:fontFamily="@font/montserrat"
                android:hint="Nombre del medicamento"
                android:paddingStart="20dp"
                android:textSize="15sp" />

            <EditText
                android:id="@+id/etDosisFrecuencia"
                android:layout_width="match_parent"
                android:layout_height="45dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_input_rounded"
                android:fontFamily="@font/montserrat"
                android:hint="Dosis y frecuencia (Ej: 1ml c/8h)"
                android:paddingStart="20dp"
                android:textSize="15sp" />

            <EditText
                android:id="@+id/etDuracion"
                android:layout_width="match_parent"
                android:layout_height="45dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_input_rounded"
                android:fontFamily="@font/montserrat"
                android:hint="Duración (Ej: 7 días)"
                android:paddingStart="20dp"
                android:textSize="15sp" />
        </LinearLayout>

        <EditText
            android:id="@+id/etRecomendaciones"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_input_rounded"
            android:fontFamily="@font/montserrat"
            android:hint="Recomendaciones generales..."
            android:inputType="textMultiLine"
            android:minLines="2"
            android:padding="16dp"
            android:textSize="15sp"
            app:layout_constraintTop_toBottomOf="@id/layoutCamposTratamiento" />

        <Button
            android:id="@+id/btnGuardarConsulta"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="32dp"
            android:background="@drawable/bg_button_rounded"
            android:fontFamily="@font/montserrat_bold"
            android:text="GUARDAR CONSULTA"
            android:textColor="@android:color/white"
            app:backgroundTint="@null"
            app:layout_constraintTop_toBottomOf="@id/etRecomendaciones" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>