<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/brand_background"
        android:padding="24dp">

        <ImageView
            android:id="@+id/ivDetalleIcono"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_icon_rounded_light"
            android:padding="12dp"
            android:src="@drawable/ic_medical_services"
            app:tint="@color/brand_green" />

        <TextView
            android:id="@+id/tvDetalleFecha"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:fontFamily="@font/montserrat_bold"
            android:text="Consulta del 2026/24/02"
            android:textAlignment="center"
            android:textColor="@color/brand_blue"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/tvDetalleVeterinario"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFamily="@font/montserrat_medium"
            android:text="Atendido por: Dr. Oscar Gonzales"
            android:textAlignment="center"
            android:textColor="@color/text_muted"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tvDetalleVitals"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="#F1F5F9"
            android:fontFamily="@font/montserrat_medium"
            android:padding="8dp"
            android:text="Peso: 5.2 kg | Temp: 38.5 °C"
            android:textAlignment="center"
            android:textColor="@color/text_primary"
            android:textSize="14sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="16dp"
            android:background="#E2E8F0" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/montserrat_bold"
            android:text="MOTIVO"
            android:textColor="@color/text_muted"
            android:textSize="11sp"
            android:letterSpacing="0.1" />

        <TextView
            android:id="@+id/tvDetalleMotivo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="@font/montserrat"
            android:text="Chequeo general por pérdida de apetito."
            android:textColor="@color/text_primary"
            android:textSize="15sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:fontFamily="@font/montserrat_bold"
            android:text="DIAGNÓSTICO"
            android:textColor="@color/text_muted"
            android:textSize="11sp"
            android:letterSpacing="0.1" />

        <TextView
            android:id="@+id/tvDetalleDiagnostico"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="@font/montserrat_medium"
            android:text="Gastroenteritis leve por cambio de dieta."
            android:textColor="@color/text_primary"
            android:textSize="15sp" />

        <LinearLayout
            android:id="@+id/layoutDetalleTratamiento"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="#E0F2F1"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/montserrat_bold"
                android:text="TRATAMIENTO RECETADO"
                android:textColor="#00695C"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/tvDetalleMedicamento"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="@font/montserrat_bold"
                android:text="Antibiótico: Amoxicilina"
                android:textColor="@color/text_primary" />

            <TextView
                android:id="@+id/tvDetalleDosisFrecuencia"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/montserrat"
                android:text="1ml cada 12 horas por 7 días"
                android:textColor="@color/text_primary"
                android:textSize="14sp" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:fontFamily="@font/montserrat_bold"
            android:text="RECOMENDACIONES"
            android:textColor="@color/text_muted"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/tvDetalleRecomendaciones"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="@font/montserrat"
            android:text="Mantener hidratado y dieta blanda por 3 días."
            android:textColor="@color/text_primary"
            android:textSize="14sp" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>